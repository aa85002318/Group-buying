# =============================================================================
# CHIMEIDIY 團購 — 環境變數範本
# 複製為 .env.local（本機）後填入真實值。切勿提交含金鑰的檔案。
# 三環境規範：docs/ENVIRONMENTS.md
# =============================================================================

# -----------------------------------------------------------------------------
# 環境識別：development | staging | production
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase（每個環境使用「自己的」專案，禁止混用）
# Production : Group buying     → https://gquavtvbbuabphzgztkb.supabase.co
# Staging    : chimeidiy-staging → https://daypinpjxhpaeckvgzhh.supabase.co
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# 站台網址
# 開發：可留空，系統會自動使用瀏覽器當前網址（localhost / 手機 LAN IP）
# Staging / Production：必填
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://shop.chimeidiygroupbuying.com
# NEXT_PUBLIC_APP_URL=

# 本機開發允許的 host（逗號分隔，供 Next.js allowedDevOrigins）
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.109

# -----------------------------------------------------------------------------
# Email（Resend）
# -----------------------------------------------------------------------------
SUPPORT_EMAIL=support@chimeidiy.com
RESEND_API_KEY=re_your_api_key
# Resend From 顯示名稱僅允許 ASCII（勿用中文）
EMAIL_FROM=CHIMEIDIY Group Buy <noreply@your-domain.com>

# -----------------------------------------------------------------------------
# 金流（正式環境再啟用；Staging 請用測試商戶）
# -----------------------------------------------------------------------------
# ECPAY_MERCHANT_ID=
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# ECPAY_ENV=test
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
# NEWEBPAY_ENV=test

# 銀行匯款資訊（前台顯示）
NEXT_PUBLIC_BANK_NAME=台灣銀行
NEXT_PUBLIC_BANK_CODE=004
NEXT_PUBLIC_BANK_ACCOUNT=123456789012
NEXT_PUBLIC_BANK_ACCOUNT_NAME=棋美點心屋
NEXT_PUBLIC_BANK_TRANSFER_NOTE=匯款後請於訂單回報帳號後五碼與金額，確認後訂單才正式成立。
NEXT_PUBLIC_PAYMENT_DEADLINE_HOURS=48

# -----------------------------------------------------------------------------
# LINE / LIFF（選用）
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_LIFF_ID=your-liff-id

# -----------------------------------------------------------------------------
# 安全相關（正式預設關閉）
# -----------------------------------------------------------------------------
# ALLOW_DEMO_SEED=0
# NEXT_PUBLIC_REQUIRE_APP=false
# NEXT_PUBLIC_ALLOW_DESKTOP=true
